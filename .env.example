# Copy to .env for local prod-like runs; in production set these in the host's dashboard.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=paid2pick.com,www.paid2pick.com

# Neon (or any Postgres). Include ?sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST/dbname?sslmode=require

# The Odds API. Unset → ingest falls back to the bundled sample.
ODDS_API_KEY=

# Economy / payments (defaults are fine to start)
P2P_PICK_PRICE=100
P2P_PLATFORM_CUT=0.30
P2P_SIGNUP_GRANT=1000
P2P_PAYMENTS_PROVIDER=fake
